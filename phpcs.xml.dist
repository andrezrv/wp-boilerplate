<?xml version="1.0"?>
<ruleset name="Custom WordPress Coding Standards">
	<description>Custom WordPress Coding Standards</description>
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="s"/>

	<exclude-pattern>config/secrets.php</exclude-pattern>

	<file>bootstrap</file>
	<file>config</file>
	<file>content/mu-plugins</file>
	<file>utils</file>

	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
</ruleset>
