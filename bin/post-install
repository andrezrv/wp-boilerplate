#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(pwd)"
TMP_CORE_DIR="$PROJECT_ROOT/.wp-core-tmp"
PUBLIC_DIR="$PROJECT_ROOT/public"

# Move freshly-installed WP core out of the temp location and into
# public/. Only moves items Composer installed into the temp dir —
# Composer's installer never sees public/ directly.
if [ -d "$TMP_CORE_DIR" ]; then
    mkdir -p "$PUBLIC_DIR"
    shopt -s dotglob nullglob
    for item in "$TMP_CORE_DIR"/*; do
        base="$(basename "$item")"
        rm -rf "${PUBLIC_DIR:?}/${base:?}"
        mv "$item" "$PUBLIC_DIR/"
    done
    shopt -u dotglob nullglob
    rmdir "$TMP_CORE_DIR" 2>/dev/null || rm -rf "$TMP_CORE_DIR"
fi

# content/uploads -> ../shared/uploads, relative, one level up from
# content/. Correct as-is for local dev (shared/ genuinely sits one
# level above the project root there). On a production deploy built on
# a GitHub Actions runner, this symlink is meaningless at build time —
# shared/ doesn't exist on the runner at all — and gets recreated
# correctly as a separate step once the built package actually lands
# on the production server, where the real path is known.
mkdir -p "$PROJECT_ROOT/content"
rm -rf "$PROJECT_ROOT/content/uploads"
ln -sfn "../../shared/uploads" "$PROJECT_ROOT/content/uploads"

# public/ symlinks, relative, favicons now under assets/
rm -f "$PUBLIC_DIR/content"
ln -sfn "../content" "$PUBLIC_DIR/content"

rm -f "$PUBLIC_DIR/favicons"
ln -sfn "../assets/favicons" "$PUBLIC_DIR/favicons"

rm -f "$PUBLIC_DIR/favicon.ico"
ln -sfn "../assets/favicons/favicon.ico" "$PUBLIC_DIR/favicon.ico"

rm -f "$PUBLIC_DIR/favicon.svg"
ln -sfn "../assets/favicons/favicon.svg" "$PUBLIC_DIR/favicon.svg"

# Sync managed plugins/themes into the live plugins/themes directories.
# Managed entries (installed by Composer into content/managed/) are symlinked
# into content/plugins/ and content/themes/ so WordPress finds them normally.
# Manually installed plugins/themes sit alongside the symlinks and are never touched.
mkdir -p "$PROJECT_ROOT/content/managed/plugins" \
         "$PROJECT_ROOT/content/managed/themes" \
         "$PROJECT_ROOT/content/plugins" \
         "$PROJECT_ROOT/content/themes"

for managed in "$PROJECT_ROOT/content/managed/plugins"/*/; do
    [ -d "$managed" ] || continue
    name="$(basename "$managed")"
    link="$PROJECT_ROOT/content/plugins/$name"
    # Only create/refresh the symlink if the slot is empty or already a symlink.
    # A real directory there is a manual install with a name collision — leave it alone.
    if [ -L "$link" ] || [ ! -e "$link" ]; then
        ln -sfn "../managed/plugins/$name" "$link"
    fi
done

for managed in "$PROJECT_ROOT/content/managed/themes"/*/; do
    [ -d "$managed" ] || continue
    name="$(basename "$managed")"
    link="$PROJECT_ROOT/content/themes/$name"
    if [ -L "$link" ] || [ ! -e "$link" ]; then
        ln -sfn "../managed/themes/$name" "$link"
    fi
done

# Remove dangling symlinks left behind by packages removed from composer.json.
# find -type l is used instead of a */ glob because */ skips dangling symlinks.
# The path is passed to rm without a trailing slash so the symlink itself is
# removed rather than dereferenced.
while IFS= read -r link; do
    [ -e "$link" ] || rm "$link"
done < <(find "$PROJECT_ROOT/content/plugins" -maxdepth 1 -type l)

while IFS= read -r link; do
    [ -e "$link" ] || rm "$link"
done < <(find "$PROJECT_ROOT/content/themes" -maxdepth 1 -type l)

echo "post-composer-install: symlinks rebuilt"

# Generate config/secrets.php if it doesn't exist yet.
if [ ! -f "$PROJECT_ROOT/config/secrets.php" ]; then
    echo "Generating config/secrets.php from WordPress secret key API..."
    { printf '<?php\n'; curl -s https://api.wordpress.org/secret-key/1.1/salt/; } \
        > "$PROJECT_ROOT/config/secrets.php"
    echo "config/secrets.php created."
fi

# Install git hooks if CaptainHook is available (dev-only dependency).
if [ -f "$PROJECT_ROOT/vendor/bin/captainhook" ]; then
    "$PROJECT_ROOT/vendor/bin/captainhook" install --run-mode=force --only-enabled -q 2>/dev/null || true
fi
