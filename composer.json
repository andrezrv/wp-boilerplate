{
	"name": "your-vendor/your-project",
	"type": "project",
	"description": "Composer-based build process for your WordPress site.",
	"license": "GPL-2.0+",
	"authors": [
		{
			"name": "Your Name",
			"email": "your@email.com",
			"homepage": "https://your-site.com"
		}
	],
	"require": {
		"php": ">=8.5",
		"vlucas/phpdotenv": "^5.6",
		"composer/installers": "^2.3",
		"johnpbloch/wordpress-core-installer": "^2.0",
		"johnpbloch/wordpress-core": "*",
		"wpackagist-plugin/akismet":  "*",
		"wpackagist-plugin/hello-dolly":  "*",
		"wpackagist-theme/generatepress": "*"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"extra": {
		"wordpress-install-dir": ".wp-core-tmp",
		"installer-paths": {
			"content/managed/plugins/{$name}/": [
				"type:wordpress-plugin"
			],
			"content/managed/themes/{$name}/": [
				"type:wordpress-theme"
			]
		}
	},
	"scripts": {
		"post-install-cmd": [
			"bash bin/post-install"
		],
		"post-update-cmd": [
			"bash bin/post-install"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"johnpbloch/wordpress-core-installer": true
		}
	}
}
